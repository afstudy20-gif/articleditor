# ─── AI providers (M5+) ──────────────────────────────────────────────
# Default provider. Gemini is primary; Anthropic + OpenAI are fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Optional secondary providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ─── Lookup polite-pool / rate-limit (optional) ─────────────────────
CROSSREF_MAILTO=
NCBI_API_KEY=
NCBI_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

NODE_ENV=production
