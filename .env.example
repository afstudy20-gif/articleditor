# ─── AI providers (M5+) ──────────────────────────────────────────────
# Default provider. Gemini is primary; Anthropic + OpenAI are fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Optional secondary providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ─── Lookup polite-pool / rate-limit (optional) ─────────────────────
CROSSREF_MAILTO=
NCBI_API_KEY=
NCBI_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

NODE_ENV=production

# ─── Graphical abstracts (ARTED × AcademicFlow) ──────────────────────────────
# The model writes a JSON spec; AcademicFlow renders it deterministically from its
# own icon library. No image model is ever involved — that is what keeps the output
# inside Elsevier's carve-out for AI-assisted schematics.
#
# Render server: run `npm run serve` in the flow-app repo (needs
# `npx playwright install chromium` once). Loopback only — the URL is used
# server-side, so anything else would make this an SSRF proxy.
FLOW_SERVER_URL=http://127.0.0.1:8787
# Set AF_API_KEY on the render server and mirror it here. Also set
# AF_CORS_ORIGIN there: its defaults let any page you visit reach 127.0.0.1:8787.
FLOW_API_KEY=
# Where the flow-app UI is served, for the "Edit in Flow" handoff.
NEXT_PUBLIC_FLOW_APP_URL=http://127.0.0.1:8899

# Local CLI author (dev machines only; no key, uses your existing CLI session).
# claude | kimi | codex — deliberately not zcode, which runs in yolo mode while this
# path feeds it manuscript text. Separate from AI_LOCAL_CLI_VISION on purpose.
AI_LOCAL_CLI_TEXT=
