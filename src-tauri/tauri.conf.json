{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ARTED",
  "version": "0.1.0",
  "identifier": "uk.drtr.arted",
  "build": {
    "frontendDist": "https://arted.drtr.uk",
    "devUrl": "https://arted.drtr.uk"
  },
  "app": {
    "windows": [
      {
        "title": "ARTED",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Academic article editor & reference manager",
    "longDescription": "ARTED — online academic writing, EndNote/Vancouver citation conversion, DOI/PubMed lookup, and a built-in PDF reader.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
